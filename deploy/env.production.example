# ---------------------------------------------------------------------------
# Bewell — .env ของเว็บจริงบน Hostinger (subdomain แยกจาก TimeOptic)
#
# ⚠ ชื่อ subdomain กับบัญชีข้างล่างยังเป็นค่าที่ตั้งไว้ก่อน (u721081539 · bewell.controlsystem-timeoptic.com)
#   ยืนยันกับ hPanel ก่อนใช้ · ฐานต้องเป็นของ Bewell เอง ห้ามชี้ไปฐานของ TimeOptic
# เหลือที่ต้องกรอกเองจริง ๆ แค่ **รหัสผ่านฐานข้อมูล** สองที่ ซึ่งมีเครื่องหมาย
# <<< กำกับไว้ทั้งคู่ · ย้ายโฮสต์หรือเปลี่ยนโดเมนเมื่อไรค่อยไล่แก้ path
#
# วางไฟล์นี้ที่ **เหนือ public_html ขึ้นไปหนึ่งชั้น** แล้วเปลี่ยนชื่อเป็น .env
#     /home/u721081539/domains/bewell.controlsystem-timeoptic.com/.env      <-- ตรงนี้
#     /home/u721081539/domains/bewell.controlsystem-timeoptic.com/public_html/
#
# ห้ามวางไว้ใน public_html — ที่นั่นเว็บเสิร์ฟได้ เหลือ .htaccess เป็นด่านเดียว
#
# ไฟล์เดียวนี้เลี้ยงทั้งสองระบบ แต่ **คนละทาง** ซึ่งเป็นที่มาของกับดักข้อใหญ่
# ข้างล่าง: หน้าร้านอ่านผ่าน api/config.php (ใช้ DB_* แล้ว putenv ต่อให้ฝั่งคลัง
# ตอน StockModule::boot()) ส่วนสคริปต์ CLI ของฝั่งคลัง bootstrap ตัวเอง ไม่ผ่าน
# api/config.php เลย จึงเห็นแต่ DATABASE_URL
# ---------------------------------------------------------------------------

# --- ฐานข้อมูล (หน้าร้าน) ---------------------------------------------------
# ค่าจากหน้า hPanel > Databases > Management
DB_HOST=localhost
DB_PORT=3306
# ตัวอ่าน .env ตัดคอมเมนต์ท้ายบรรทัดไม่เป็น — เขียน DB_PASS=abc # หมายเหตุ
# แล้วรหัสผ่านจะกลายเป็น "abc # หมายเหตุ" ทั้งดุ้น หมายเหตุต้องขึ้นบรรทัดใหม่เสมอ
DB_USER=u721081539_bewell
# <<< กรอกรหัสผ่านฐานข้อมูลต่อท้ายบรรทัดล่างนี้ ไม่ต้องใส่เครื่องหมายคำพูด
DB_PASS=
DB_NAME=u721081539_bewell

# --- ฐานข้อมูล (ระบบคลัง) ---------------------------------------------------
# ฐานเดียวกันเป๊ะกับข้างบน แค่คนละรูปแบบ — ฝั่งคลังเขียนไว้เป็น URL เดียว
#
# ⚠ บรรทัดที่ลืมแก้บ่อยที่สุด และลืมแล้ว **ไม่มีอะไรฟ้อง** — เว็บใช้งานได้ครบ
#   ทุกหน้าเพราะมันเดินทาง DB_* ส่วนที่ตายคือ cron ฝั่งคลังทั้งชุด และตายแบบ
#   exit 255 พิมพ์ออกมา 0 ไบต์ (display_errors ปิดบนโฮสต์) ตั้ง Cron Job ไป
#   ก็เงียบสนิท กว่าจะรู้คือวันที่ของหมดสต๊อกแล้วไม่มีใครได้แจ้งเตือน
#
# ห้ามพิมพ์เอง — ให้ประกอบจาก DB_* ข้างบน รหัสผ่านจะถูก percent-encode ให้เอง
# (@ -> %40  # -> %23  / -> %2F) รันบรรทัดเดียวนี้บนเซิร์ฟเวอร์หลังกรอก DB_PASS:
#
#   cd ~/domains/bewell.controlsystem-timeoptic.com && php -r '$f=".env";$t=file_get_contents($f);
#   $g=fn($k)=>preg_match("/^$k=\"?([^\"\r\n]*)\"?$/m",$t,$m)?trim($m[1]," \"\x27"):"";
#   $u=sprintf("mysql://%s:%s@%s:%s/%s",rawurlencode($g("DB_USER")),rawurlencode($g("DB_PASS")),
#   $g("DB_HOST"),$g("DB_PORT"),$g("DB_NAME"));
#   file_put_contents($f,preg_replace("/^DATABASE_URL=.*$/m","DATABASE_URL=\"$u\"",$t));echo "$u\n";'
#
# <<< รหัสผ่านที่ percent-encode แล้ว ลงตรงกลางระหว่าง : กับ @ ของบรรทัดล่างนี้
DATABASE_URL="mysql://u721081539_bewell:@localhost:3306/u721081539_bewell"

# --- คุกกี้ล็อกอิน ----------------------------------------------------------
# หน้าเว็บกับ API อยู่โดเมนเดียวกันแล้ว Lax จึงถูกต้อง ไม่ต้องใช้ None
# SESSION_SECURE=1 คู่กับกฎบังคับ https ใน .htaccess — ตั้งอย่างเดียวไม่ตั้งอีกอย่าง
# จะได้อาการ "ล็อกอินผ่านแล้วเด้งกลับหน้า login" ที่ไม่มี error ให้เห็น
SESSION_SAMESITE="Lax"
SESSION_SECURE="1"

# ที่เก็บไฟล์ session — ต้องอยู่นอก public_html และต้อง **มีอยู่จริง**
#
# ⚠ อีกบรรทัดที่ลืมแก้แล้วไม่มีอะไรฟ้อง — โค้ดพยายาม mkdir ให้ ถ้าไม่สำเร็จมัน
#   ไม่เรียก session_save_path() แล้วเงียบ ๆ ตกไปใช้ temp กลางของเครื่อง ซึ่ง
#   PHP ตัวอื่นบนเครื่องเดียวกันที่ใช้ gc_maxlifetime 24 นาทีจะกวาด session ของ
#   เราทิ้งแทนเรา · อาการคือคนใช้งานหลุดล็อกอินเป็นพัก ๆ หาสาเหตุไม่เจอ
#
#   สร้างโฟลเดอร์ก่อนด้วย:  mkdir -p ~/domains/bewell.controlsystem-timeoptic.com/sessions
#                          chmod 700 ~/domains/bewell.controlsystem-timeoptic.com/sessions
SESSION_PATH="/home/u721081539/domains/bewell.controlsystem-timeoptic.com/sessions"

# --- Telegram: กลุ่ม "Be Well คิวลูกค้า | TimeOptic" --------------------
# ตั้งที่นี่จะชนะค่าที่บันทึกไว้ในหน้า "ตั้งค่า" เสมอ · ปล่อยว่าง = ใช้ค่าในฐาน
#
# ระวังตอนย้ายจากเครื่องที่ร้าน: ถ้าใส่โทเคนชุดเดียวกับที่เครื่องร้านถืออยู่ แล้ว
# ตั้ง Cron Job ที่นี่ด้วย กลุ่มจริงจะได้ข้อความซ้ำสองทาง — ปิดงานที่เครื่องร้าน
# ก่อน แล้วค่อยเติมตรงนี้
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram: กลุ่ม "Be Well รายงานการส่งมอบ | TimeOptic" --------------
DIGEST_TELEGRAM_BOT_TOKEN=
DIGEST_TELEGRAM_CHAT_ID=

# --- Telegram: กลุ่มรูปวัด Center (ปุ่ม "ส่งรูป" ในขั้นวัด Center) -------------
# ว่างไว้ = ปุ่มส่งไม่ออก ไม่มี fallback ไปกลุ่มคิวลูกค้า (รูปใบหน้าลูกค้าห้ามหลุดไปกลุ่มอื่น)
CENTERING_TELEGRAM_BOT_TOKEN=
CENTERING_TELEGRAM_CHAT_ID=

# --- Telegram: ของต่ำกว่าขั้นต่ำ / ของค้างสต๊อก (ฝั่งคลัง) -------------------
# คนละกลุ่มกับคิวลูกค้าโดยตั้งใจ ว่างไว้ = ไม่ส่ง ไม่มี fallback ไปหยิบคีย์ข้างบน
STOCK_TELEGRAM_BOT_TOKEN=
STOCK_TELEGRAM_CHAT_ID=

# --- การตัดสต๊อกเวลาขาย -----------------------------------------------------
# ชื่อคีย์ยังขึ้นต้นว่า STOCK_API_ ตามของเดิมสมัยฝั่งคลังอยู่คนละเครื่องและคุยกัน
# ทาง HTTP · ตอนนี้ StockClient ไม่มี HTTP เหลือแล้วสักบรรทัด (เรียก StockGate
# ในโปรเซสเดียวกัน ดู api/services/StockClient.php) จึงไม่มีเรื่อง "ยิงหาตัวเอง"
# ให้ต้องกลัวอีก และไม่ต้องมีบัญชีกลาง — ทุกอย่างทำในนามคนที่ล็อกอินอยู่จริง
#
# live = ตัดของจริง · dry = จดว่าจะตัดอะไรแต่ไม่ขยับของ · off = ไม่ทำอะไรเลย
#
# ⚠ off กับ dry **ไม่ทำให้การขายพัง** — บิลออกได้ตามปกติ แค่ของในคลังไม่ลด
#   และไม่มีข้อความเตือนที่หน้าจอ ตั้งผิดไว้แล้วจะรู้ตัวตอนนับสต๊อกสิ้นเดือน
STOCK_API_MODE=live

# เลิกใช้แล้วทั้งสามตัว เก็บไว้ให้ค่าที่ค้างอยู่ในเครื่องเก่าไม่ทำให้ config พัง
# ห้ามใส่ค่ากลับเข้าไป — โดยเฉพาะ STOCK_API_URL ที่เครื่องในร้านเป็น IP วง LAN
STOCK_API_URL=
STOCK_API_USER=
STOCK_API_PASS=

# ---------------------------------------------------------------------------
# ตรวจก่อนบอกว่าเสร็จ — สามบรรทัดนี้จับกับดักทั้งหมดข้างบนได้
#
#   cd ~/domains/bewell.controlsystem-timeoptic.com/public_html
#
#   php stock/api/bin/migrate.php --dry    # ต้องขึ้น "ไม่มี migration ค้าง — ทั้งหมด NN ไฟล์รันไปแล้ว"
#                                          # ถ้าได้ exit 255 เงียบ ๆ = DATABASE_URL ผิด
#                                          # ดูข้อความจริงด้วย php -d display_errors=1 ...
#   php stock/api/bin/doctor.php           # ตรวจส่วนขยาย เขตเวลา ฐาน ตาราง ยอดคงเหลือ
#   php api/cli/reminder.php               # ต้อง exit 0 (ตัวนี้ใช้ DB_* จึงผ่านแม้ DATABASE_URL พัง)
#
# แล้วเปิดเว็บล็อกอินจริงหนึ่งรอบ · ต้องมีไฟล์ sess_* โผล่ใน ../sessions/
# ถ้าล็อกอินผ่านแต่โฟลเดอร์ยังว่าง = SESSION_PATH ยังไม่มีผล
# ---------------------------------------------------------------------------
