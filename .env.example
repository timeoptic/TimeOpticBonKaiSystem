# คัดลอกเป็น .env ที่รากโปรเจกต์แล้วใส่ค่าจริง
#   copy .env.example .env
# .env ถูก git ignore ไว้ — ห้าม commit ค่าจริง

# ---------------------------------------------------------------------------
# ฐานข้อมูล
# ---------------------------------------------------------------------------
# MariaDB บนเครื่องในร้าน ใช้ร่วมกับระบบหน้าร้าน
# อักขระพิเศษในรหัสผ่านต้อง percent-encode (@ -> %40, # -> %23)
DATABASE_URL="mysql://user:password@192.168.1.107:3306/timeoptic"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# origin ของ frontend ที่อนุญาตให้เรียกข้ามมาได้ คั่นด้วยจุลภาค
# ต้องระบุให้ตรงตัว — เครื่องหมาย * ใช้ไม่ได้เมื่อคำขอพก cookie มาด้วย
API_ALLOWED_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------------------
# ตัวนี้ตัดสินว่าเบราว์เซอร์จะแนบ cookie ไปกับ fetch ที่ frontend ยิงหรือไม่
#
#   Lax   — ค่าเริ่มต้น ใช้ได้เมื่อ frontend กับ API อยู่ "site" เดียวกัน
#           localhost:3000 กับ localhost:8080 นับเป็น site เดียวกัน พอร์ตไม่มีผล
#
#   None  — ต้องใช้เมื่อ API อยู่คนละโดเมนกับหน้าเว็บ และ **ต้องคู่กับ
#           SESSION_SECURE=1 เสมอ** เพราะเบราว์เซอร์ปฏิเสธ None ที่ไม่มี Secure
#           ซึ่งแปลว่าต้องเสิร์ฟผ่าน HTTPS
#
# อาการเวลาตั้งผิด: ล็อกอินผ่าน แต่ทุกคำขอหลังจากนั้นตอบ 401 โดยไม่มีสาเหตุให้เห็น
SESSION_SAMESITE="Lax"
SESSION_SECURE="0"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# ที่อยู่ API ที่เบราว์เซอร์จะยิงไป ค่านี้ถูกฝังลง bundle ตอน build
# เปลี่ยนแล้วต้อง build ใหม่
NEXT_PUBLIC_API_BASE="http://localhost:8080/api"
