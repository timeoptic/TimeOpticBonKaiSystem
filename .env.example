# ตั้งค่าการเชื่อมต่อฐานข้อมูล (ค่าปริยายตรงกับ XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=timeoptic
PORT=3000

# Telegram bot (ตัวเลือก — ตั้งในหน้า "ตั้งค่า" ก็ได้)
# ค่าที่ตั้งตรงนี้จะชนะค่าที่บันทึกไว้ในฐานข้อมูลเสมอ
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ระบบคลัง (โปรเจกต์แยก คนละเครื่อง) — ตัดสต็อกผ่าน HTTP API ของเขา
# IP มาจาก DHCP เปลี่ยนได้ · start.bat ฝั่งคลังพิมพ์เลขปัจจุบันให้ทุกครั้ง
STOCK_API_URL=http://192.168.1.108:8080/api
STOCK_API_USER=
STOCK_API_PASS=
# off = ไม่ทำอะไร · dry = ประกอบ payload แล้วบันทึกไว้ ไม่ยิงจริง · live = ยิงจริง
STOCK_API_MODE=off
